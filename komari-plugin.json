{
  "$schema": "https://raw.githubusercontent.com/komari-monitor/plugin-sdk/master/schema/komari-plugin.schema.json",
  "name": {
    "zh_CN": "UFW 同步",
    "en": "UFW Sync"
  },
  "short": "ufw-sync",
  "description": "Centrally sync a UFW whitelist (fleet IPs + DDNS home exits) and per-node public ports to every agent via admin:exec. Default is check/dry-run; flip the 'apply' switch to enforce. Edit whitelist lists and public ports on the plugin's admin page.",
  "author": "lddcc",
  "version": "0.7.0",
  "url": "https://github.com/lddcc/komari-ufw-sync",
  "komari": ">=1.4.0",
  "entry": "script.js",
  "permissions": {
    "allowSystemRPC": true,
    "allowRoutes": true,
    "node": true,
    "timeout": 120
  },
  "pages": [
    {
      "file": "web/index.html",
      "title": { "zh_CN": "UFW 同步", "en": "UFW Sync" },
      "icon": "web/shield.svg",
      "type": "iframe",
      "visibility": "admin"
    },
    {
      "file": "web/config.html",
      "title": { "zh_CN": "UFW 配置", "en": "UFW Config" },
      "icon": "web/settings.svg",
      "type": "iframe",
      "visibility": "admin"
    }
  ],
  "configuration": {
    "type": "managed",
    "data": [
      {
        "key": "trigger_token",
        "name": { "zh_CN": "手动触发令牌", "en": "Manual trigger token" },
        "type": "string",
        "default": "",
        "help": {
          "zh_CN": "设置后可用 GET /sync?token=<此值> 手动触发。登录管理员无需 token。留空则禁用匿名手动触发。",
          "en": "When set, GET /sync?token=<value> triggers manually. Logged-in admins need no token. Empty disables anonymous triggering."
        }
      }
    ]
  }
}
